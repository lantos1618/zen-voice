// Inference sends typed messages to the result actor. A bounded pipe bridges
// that actor to the caller thread; neither actor touches UI state.
Recognizer, NativeError = parakeet
Ptr, null_ptr = std.mem
str_at = std.text

Posix = c.bind("unistd.h", {
    pipe* = (descriptors: Ptr<i32>) i32
    // The header supplies ssize_t; C's result conversion maps -1 to usize.MAX.
    // Every count is bounded before use, so the sentinel cannot be a byte count.
    read* = (fd: i32, bytes: Ptr<u8>, count: usize) usize
    write* = (fd: i32, bytes: Ptr<u8>, count: usize) usize
    close* = (fd: i32) i32
})
Errors = c.bind("errno.h", { __error* = () Ptr<i32> })
PollFd = { fd: i32, events: i16, returned: i16 }
Polling = c.bind("poll.h", "poll", {
    ready* = (descriptors: Ptr<PollFd>, count: u32, timeout: i32) i32
})

MailboxError* = OpenFailed | ReadFailed | Closed
// Numeric metadata only. Zero request disables all tracing clocks/header work.
// Times are absolute monotonic nanoseconds from the caller's Env clock.
VoiceTrace* = { request* :: u64 = 0, parent* :: u64 = 0, enqueued* :: u64 = 0, started* :: u64 = 0, ended* :: u64 = 0, replied* :: u64 = 0 }
Transcript* = { trace* :: VoiceTrace = VoiceTrace(), preparation*: bool, success*: bool, text*: str, session*: usize, final*: bool, ends_capture*: bool, count*: usize }

// The UI admits one job until its complete reply arrives. The result actor
// writes that reply; rejected result admission uses the worker error fallback.
// A reply is an optional 56-byte trace header, status, <=4000 text bytes, NUL.
// This macOS app relies on Darwin's pipe buffer holding the one <=4058-byte reply
// during close/join. PIPE_BUF is an atomicity limit, not that buffer's capacity;
// a single writer plus partial-read framing does not require an atomic record.
write_all = (fd: i32, text: str) bool {
    offset ::= 0;
    good   ::= true;
    loop(good && offset < text.len, (h) {
        count = Posix.write(fd, text.ptr().offset(offset), text.len - offset);
        (count > 0 && count <= text.len - offset).match({
            true  => { offset = offset + count; },
            false => { good = count == usize.MAX && Errors.__error().read(
                0
            ) == 4; },
        });
    });
    good
}

write_reply_body = (fd: i32, success: bool, text: str) () {
    length ::= text.len;
    (length > 4000).then(() {
        length = 4000;
        loop(length > 0 && text.ptr().read(length) >= 128 && text.ptr().read(length) < 192, (h) {
            length = length - 1;
        });
    });
    status = success.match({true => "T", false => "E"});
    write_all(fd, status).then(() {
        write_all(fd, text.slice(0, length)).then(() { write_all(fd, "\0"); });
    });
}

// Optional 56-byte native-process header. The existing single-writer framing
// stays bounded at 4058 bytes, below the caller's 4096-byte buffer. Disabled
// tracing uses exactly the legacy status/text/NUL framing and no trace scratch.
write_reply = (fd: i32, env: Env, trace: VoiceTrace, success: bool, text: str) () {
    (trace.request == 0).match({
        true => write_reply_body(fd, success, text),
        false => {
            scratch = env.mem.alloc();
            scratch.realloc<u64>(null_ptr<u64>(), 7).match({
                Err(_) => write_reply_body(fd, false, "Cannot allocate trace reply header."),
                Ok(header) => {
                    header.write(0, 72); // H followed by padding, on Apple targets.
                    header.write(1, trace.request); header.write(2, trace.parent);
                    header.write(3, trace.enqueued); header.write(4, trace.started);
                    header.write(5, trace.ended); header.write(6, env.clock.since_start().ns);
                    write_all(fd, str_at(header.to<u8>(), 56)).then(() { write_reply_body(fd, success, text); });
                },
            });
        },
    });
}

// Serialize actor results for the main-thread UI. Message text is copied by
// the actor runtime, so the inference scratch arena can be released immediately.
Results = { output: i32 }
Results.impl(Actor, {
    deliver = (self :: @Self, ctx: Context, trace: VoiceTrace, success: bool, text: str) {
        write_reply(self.output, ctx.env, trace, success, text);
    }
})

reply = (results: Ref<Results>, fallback: i32, env: Env, trace: VoiceTrace, success: bool, text: str) () {
    timing ::= trace;
    (trace.request > 0).then(() { timing = VoiceTrace(request: trace.request, parent: trace.parent, enqueued: trace.enqueued, started: trace.started, ended: env.clock.since_start().ns); });
    results.deliver(timing, success, text).match({
        Ok(_)  => (),
        Err(_) => write_reply(
            fallback,
            env,
            timing,
            false,
            "Cannot enqueue transcription result."
        ),
    });
}

Worker = {
    results: Ref<Results>,
    fallback: i32,
    recognizer :: Res<Recognizer>,

}

Worker.impl(Actor, {
    transcribe = (self :: @Self, ctx: Context, model: str, gpu: i32, pcm: str, rate: i32, preparation: bool, trace: VoiceTrace) {
        timing ::= trace;
        (trace.request > 0).then(() { timing = VoiceTrace(request: trace.request, parent: trace.parent, enqueued: trace.enqueued, started: ctx.env.clock.since_start().ns); });
        scratch ::= ctx.env.mem.alloc();
        self.recognizer.match({
            None  => {
                Recognizer.open(scratch, model, gpu).match({
                    Ok(recognizer) => { self.recognizer = Ok(recognizer); },
                    Err(error)     => error.match({
                        NativeError(detail) => reply(
                            self.results,
                            self.fallback, ctx.env, timing,
                            false,
                            detail.message.view()
                        ),
                        _                   => reply(
                            self.results,
                            self.fallback, ctx.env, timing,
                            false,
                            "Cannot load Parakeet model."
                        ),
                    }),
                });
            },
            Ok(_) => (),
        });
        self.recognizer.match({
            None           => (),
            Ok(recognizer) => {
                // Actor message bytes are copied; copy again into f32-aligned
                // storage instead of assuming the packed str payload alignment.
                count = preparation.match({true => 16000, false => pcm.len / 4});
                scratch.realloc<f32>(null_ptr<f32>(), count).match({
                    Err(_)      => reply(
                        self.results,
                        self.fallback, ctx.env, timing,
                        false,
                        "Cannot allocate audio buffer."
                    ),
                    Ok(samples) => {
                        preparation.match({
                            true  => Range(0, count).loop((i) { samples.write(i, 0.0); }),
                            false => samples.to<u8>().copy_from(
                                pcm.ptr(),
                                count * 4
                            ),
                        });
                        recognizer.transcribe(
                            scratch,
                            samples,
                            count,
                            rate
                        ).match({
                            Ok(text)   => reply(
                                self.results,
                                self.fallback, ctx.env, timing,
                                true,
                                preparation.match({true => "", false => text.view()})
                            ),
                            Err(error) => error.match({
                                NativeError(detail) => reply(
                                    self.results,
                                    self.fallback, ctx.env, timing,
                                    false,
                                    detail.message.view()
                                ),
                                _                   => reply(
                                    self.results,
                                    self.fallback, ctx.env, timing,
                                    false,
                                    "Parakeet transcription failed."
                                ),
                            }),
                        });
                    },
                });
            },
        });
    }

    stopped = (self :: @Self, ctx: Context) {
        self.recognizer.match({
            Ok(recognizer) => { owner ::= recognizer; owner.close(); },
            None           => (),
        });
        self.recognizer = None;
    }
})

// Single owning handle. Keep a alive through close(), and do not copy a live
// handle. close drains the worker: native inference does not support cancellation.
Transcriber* = {
    worker: Ref<Worker>,
    results: Ref<Results>,
    input :: i32,
    output :: i32,
    descriptor: Ptr<PollFd>,
    buffer: Ptr<u8>,
    identity: Ptr<u8>,
    identity_length :: usize,
    identity_gpu :: i32,
    inflight_preparation :: bool,
    used :: usize,
    busy* :: bool,
    inflight :: usize,
    inflight_final :: bool,
    inflight_end :: bool,
    inflight_count :: usize,
    trace_next :: VoiceTrace = VoiceTrace(),
    inflight_trace :: VoiceTrace = VoiceTrace(),

    open* = (env: Env, a: Alloc) Res<Transcriber, MailboxError
        | ActorStartError
        | AllocError> {
        descriptors = a.realloc<i32>(null_ptr<i32>(), 2).try();
        @scope.defer(() { a.free(descriptors); });
        buffer     = a.realloc<u64>(null_ptr<u64>(), 512).try().to<u8>();
        descriptor = a.create<PollFd>().try();
        identity   = a.realloc<u8>(null_ptr<u8>(), 4096).try();
        (Posix.pipe(descriptors) == 0).ensure(MailboxError.OpenFailed).try();
        input  = descriptors.read(0);
        output = descriptors.read(1);
        descriptor.write(0, PollFd(fd: input, events: 1, returned: 0));
        env.spawn(Results(output: output)).match({
            Err(error)  => { Posix.close(input); Posix.close(output); Err(error) },
            Ok(results) => env.spawn(Worker(
                results: results,
                fallback: output,
                recognizer: None
            )).match({
                Err(error) => {
                    results.stop();
                    results.join();
                    Posix.close(input);
                    Posix.close(output);
                    Err(error)
                },
                Ok(worker) => Ok(Transcriber(
                    worker: worker,
                    results: results,
                    input: input,
                    output: output,
                    descriptor: descriptor,
                    buffer: buffer,
                    identity: identity,
                    identity_length: 0,
                    identity_gpu: 0,
                    inflight_preparation: false,
                    used: 0,
                    busy: false,
                    inflight: 0,
                    inflight_final: true,
                    inflight_end: true,
                    inflight_count: 0
                )),
            }),
        })
    }

    // Configure the next admission; in-flight context is carried in the message.
    tracing* = (self :: @Self, trace: VoiceTrace) () { self.trace_next = trace; }

    compatible = (self: @Self, model: str, gpu: i32) bool {
        model.len > 0 && model.len <= 4096 && !model.contains(0) &&
            (self.identity_length == 0 || (self.identity_gpu == gpu && str_at(self.identity, self.identity_length).eq(model)))
    }

    remember = (self :: @Self, model: str, gpu: i32) () {
        (self.identity_length == 0).then(() {
            self.identity.copy_from(model.ptr(), model.len);
            self.identity_length = model.len;
            self.identity_gpu    = gpu;
        });
    }

    // Model load and a one-second silence decode run on the inference actor.
    // The reply is explicitly preparation, never user-visible transcription.
    prepare* = (self :: @Self, model: str, gpu: i32) Res<bool, ActorError> {
        (self.busy || self.input < 0 || !self.compatible(model, gpu)).match({
            true  => Ok(false),
            false => {
                self.worker.transcribe(model, gpu, "", 16000, true, self.trace_next).try();
                self.inflight_trace = self.trace_next;
                self.trace_next = VoiceTrace();
                self.remember(model, gpu);
                self.used                 = 0;
                self.busy                 = true;
                self.inflight_preparation = true;
                self.inflight             = 0;
                self.inflight_final       = false;
                self.inflight_end         = false;
                self.inflight_count       = 0;
                Ok(true)
            },
        })
    }

    // The first admitted model/gpu identity stays pinned until close.
    submit* = (self :: @Self, model: str, gpu: i32, samples: Ptr<f32>, count: usize, rate: i32)
              Res<bool, ActorError> {
        (self.busy || self.input < 0 || !self.compatible(
            model,
            gpu
        ) || samples.is_null() || count == 0 || count > 5760000).match({
            true  => Ok(false),
            false => {
                self.worker.transcribe(
                    model,
                    gpu,
                    str_at(samples.to<u8>(), count * 4),
                    rate,
                    false,
                    self.trace_next
                ).try();
                self.inflight_trace = self.trace_next;
                self.trace_next = VoiceTrace();
                self.remember(model, gpu);
                self.inflight_preparation = false;
                self.used                 = 0;
                self.busy                 = true;
                self.inflight             = 0;
                self.inflight_final       = true;
                self.inflight_end         = true;
                self.inflight_count       = count;
                Ok(true)
            },
        })
    }

    snapshot* = (self :: @Self, model: str, gpu: i32, session: usize, samples: Ptr<f32>, count: usize, rate: i32, finish: bool)
            Res<bool, ActorError> {
        (self.busy || self.input < 0 || !self.compatible(
            model,
            gpu
        ) || session == 0 || samples.is_null() || count == 0 || count > 480000).match({
            true  => Ok(false),
            false => {
                self.worker.transcribe(
                    model,
                    gpu,
                    str_at(samples.to<u8>(), count * 4),
                    rate,
                    false,
                    self.trace_next
                ).try();
                self.inflight_trace = self.trace_next;
                self.trace_next = VoiceTrace();
                self.remember(model, gpu);
                self.inflight_preparation = false;
                self.used                 = 0;
                self.busy                 = true;
                self.inflight             = session;
                self.inflight_final       = finish;
                self.inflight_end         = finish;
                self.inflight_count       = count;
                Ok(true)
            },
        })
    }

    segment* = (self :: @Self, model: str, gpu: i32, session: usize, samples: Ptr<f32>, count: usize, rate: i32, finalize: bool, ends_capture: bool)
               Res<bool, ActorError> {
        accepted = self.snapshot(
            model,
            gpu,
            session,
            samples,
            count,
            rate,
            finalize
        ).try();
        accepted.then(() { self.inflight_end = ends_capture; });
        Ok(accepted)
    }

    // Returned text borrows this handle's buffer until the next submit/poll.
    poll* = (self :: @Self) Res<Res<Transcript>, MailboxError> {
        (!self.busy).match({
            true  => Ok(None),
            false => self.read_reply(),
        })
    }

    read_reply = (self :: @Self) Res<Res<Transcript>, MailboxError> {
        ready = Polling.ready(self.descriptor, 1, 0);
        (ready >= 0 || Errors.__error().read(0) == 4).ensure(MailboxError.ReadFailed).try();
        (ready <= 0).match({
            true  => Ok(None),
            false => {
                count = Posix.read(
                    self.input,
                    self.buffer.offset(self.used),
                    4096 - self.used
                );
                (count > 0 && count <= 4096 - self.used).ensure(
                    MailboxError.ReadFailed
                ).try();
                self.used = self.used + count;
                traced = self.buffer.read(0) == 'H';
                offset = traced.match({true => 57, false => 1});
                (self.used >= offset + 1 && self.buffer.read(self.used - 1) == 0).match({
                    false => {
                        (self.used < 4096).ensure(
                            MailboxError.ReadFailed
                        ).try();
                        Ok(None)
                    },
                    true  => {
                        self.busy = false;
                        words = self.buffer.to<u64>();
                        timing = traced.match({true => VoiceTrace(request: words.read(1), parent: words.read(2), enqueued: words.read(3), started: words.read(4), ended: words.read(5), replied: words.read(6)), false => self.inflight_trace});
                        Ok(Ok(Transcript(
                            trace: timing,
                            preparation: self.inflight_preparation,
                            success: self.buffer.read(offset - 1) != 'E',
                            text: str_at(self.buffer.offset(offset), self.used - offset - 1),
                            session: self.inflight,
                            final: self.inflight_final,
                            ends_capture: self.inflight_end,
                            count: self.inflight_count
                        )))
                    },
                })
            },
        })
    }

    close* = (self :: @Self) () {
        (self.input >= 0).then(() {
            self.worker.stop();
            self.worker.join();
            self.results.stop();
            self.results.join();
            Posix.close(self.input);
            Posix.close(self.output);
            self.input  = -1;
            self.output = -1;
            self.busy   = false;
        });
    }
}

// Main-thread admission state: native work has one in-flight message, no queued
// audio backlog. A new recording supersedes any previous session's reply.
Live* = {
    session* :: usize = 0,
    sent* :: usize = 0,
    finished* :: bool = false,
    failed* :: bool = false,

    observe* = (self :: @Self, session: usize) () {
        (self.session != session).then(() {
            self.session  = session;
            self.sent     = 0;
            self.finished = false;
            self.failed   = false;
        });
    }

    due* = (self: @Self, count: usize, active: bool, busy: bool) bool {
        self.session > 0 && !busy && !self.failed && count > 0 && count >= self.sent &&
            active.match({true => count - self.sent >= 16000, false => !self.finished})
    }

    accepted* = (self :: @Self, count: usize, active: bool) () {
        self.sent     = count;
        self.finished = !active;
    }

    // Quiet phrase boundaries after eight seconds; fifteen seconds is the
    // hard bounded-context limit even if speech never pauses.
    finalize* = (self: @Self, count: usize, active: bool, quiet: bool) bool {
        !active || count >= 240000 || (count >= 128000 && quiet)
    }

    segment_count* = (self: @Self, count: usize) usize {
        (count > 240000).match({true => 240000, false => count})
    }

    due_segment* = (self: @Self, count: usize, active: bool, busy: bool, quiet: bool) bool {
        self.due(count, active, busy) || (self.session > 0 && !busy && !self.failed && !self.finished && count > 0 && self.finalize(count, active, quiet))
    }

    accepted_segment* = (self :: @Self, count: usize, active: bool) () {
        self.accepted(count, active);
    }

    // Call only after a successful current-session final reply AND exact
    // prefix removal. Any tail that arrived while decoding stays pending.
    committed* = (self :: @Self, session: usize, remaining: usize, active: bool) bool {
        self.current(session).match({
            false => false,
            true  => { self.sent = 0; self.finished = !active && remaining == 0; true },
        })
    }

    current* = (self: @Self, session: usize) bool { self.session == session }

    fail* = (self :: @Self) () { self.failed = true; }
}

quiet_tail* = (samples: Ptr<f32>, count: usize) bool {
    (count < 4800 || samples.is_null()).match({
        true  => false,
        false => {
            energy ::= 0.0;
            Range(count - 4800, count).loop((i) {
                value  = samples.read(i).to_f64();
                energy = energy + value * value;
            });
            energy / 4800.0 < 0.00001
        },
    })
}
